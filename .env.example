# Copier en .env.local et compléter. Sans les clés Supabase, l'application tourne en mode démo.

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Paris, eu-west-3) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement (webhooks de paiement, tâches). Ne jamais l'exposer.
SUPABASE_SECRET_KEY=

# ── Paiement : PayDunya (Wave, Orange Money, Free Money/Yas, carte) ──────────
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=

# ── Fonctions Edge Supabase (à définir avec `supabase secrets set`) ─────────
# SEND_SMS_HOOK_SECRET=        secret du Send SMS Hook (format v1,whsec_…)
# ORANGE_SMS_CLIENT_ID=        API SMS Orange Sénégal
# ORANGE_SMS_CLIENT_SECRET=
# ORANGE_SMS_SENDER_PHONE=     numéro expéditeur au format +221…
# TWILIO_ACCOUNT_SID=          secours si Orange échoue
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TURNSTILE_SECRET_KEY=        CAPTCHA des demandes de code
