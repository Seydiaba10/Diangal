# Copier en .env.local et compléter. Sans les clés Supabase, l'application tourne en mode démo.

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# « demo » : données de démonstration (src/mocks). « supabase » : vraie base et vraie connexion.
DIANGAL_DATA_SOURCE=demo
# « true » quand un fournisseur SMS (Orange, Twilio) est branché à Supabase Auth : connexion par SMS.
DIANGAL_SMS_ENABLED=false
# « true » quand le code peut partir sur WhatsApp (fonction send-sms déployée + WhatsApp Business de Meta).
DIANGAL_WHATSAPP_ENABLED=false
# « true » quand les emails d'Auth contiennent le code {{ .Token }} (SMTP personnalisé) ; sinon, lien de connexion.
DIANGAL_EMAIL_CODE=false

# ── Supabase (Irlande, eu-west-1 ; Paris envisagé avant le lancement) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement (webhooks de paiement, tâches). Ne jamais l'exposer.
SUPABASE_SECRET_KEY=
# Mot de passe de la base : sert seulement à installer les tables (supabase db push).
SUPABASE_DB_PASSWORD=
# Jeton d'accès personnel Supabase (CLI et API de gestion), alternative au mot de passe.
SUPABASE_ACCESS_TOKEN=

# ── Paiement : PayDunya (Wave, Orange Money, Free Money/Yas, carte) ──────────
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=

# ── Fonctions Edge Supabase (à définir avec `supabase secrets set`) ─────────
# SEND_SMS_HOOK_SECRET=        secret du Send SMS Hook (format v1,whsec_…)
# ORANGE_SMS_CLIENT_ID=        API SMS Orange Sénégal
# ORANGE_SMS_CLIENT_SECRET=
# ORANGE_SMS_SENDER_PHONE=     numéro expéditeur au format +221…
# WHATSAPP_TOKEN=              jeton permanent de l'API WhatsApp Cloud (Meta)
# WHATSAPP_PHONE_NUMBER_ID=    identifiant du numéro WhatsApp Business
# WHATSAPP_TEMPLATE=           modèle d'authentification approuvé (défaut : diangal_code, langue fr)
# TWILIO_ACCOUNT_SID=          secours si Orange échoue
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TURNSTILE_SECRET_KEY=        CAPTCHA des demandes de code
